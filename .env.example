# Database (SQLite file)
# Local dev: file:./dev.db
# Vercel production: file:/tmp/dev.db (synced to Vercel Blob automatically)
DATABASE_URL="file:./dev.db"

# Auth (custom JWT with jose - NOT NextAuth.js)
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-here"

# App URL (used for QR codes, canonical URLs, OG images)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Web3Forms (for feedback & registration email notifications only)
# Get your access key at: https://web3forms.com/
WEB3FORMS_ACCESS_KEY="your-web3forms-access-key"
NEXT_PUBLIC_WEB3FORMS_KEY="your-web3forms-access-key"

# Vercel Blob (auto-set by `vercel blob create-store --yes`)
# Used to persist SQLite database file across serverless cold starts
BLOB_READ_WRITE_TOKEN="your-blob-read-write-token"
BLOB_STORE_ID="your-blob-store-id"
# Database (PostgreSQL via Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth (custom JWT with jose - NOT NextAuth.js)
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-here"

# App URL (used for QR codes, canonical URLs, OG images)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Web3Forms (for feedback & registration email notifications only)
# Get your access key at: https://web3forms.com/
WEB3FORMS_ACCESS_KEY="your-web3forms-access-key"
NEXT_PUBLIC_WEB3FORMS_KEY="your-web3forms-access-key"
